<?xml version="1.0" ?>
<robot name="ur_with_end_effector">

  <!-- ========================== -->
  <!--     VIRTUAL JOINT          -->
  <!-- ========================== -->
  <virtual_joint
      name="world_joint"
      type="fixed"
      parent_frame="world"
      child_link="base_link"/>

  <!-- ========================== -->
  <!--    ARM GROUP (UR5e)        -->
  <!-- ========================== -->
  <group name="manipulator">
    <chain base_link="base_link" tip_link="wrist_3_link"/>
  </group>

  <!-- ========================== -->
  <!--   END EFFECTOR GROUP       -->
  <!-- ========================== -->
  <group name="gripper">
    <link name="end_effector_mount_connector"/>
    <link name="end_effector_main_frame"/>
    <link name="slider_rod_upper"/>
    <link name="slider_rod_lower"/>
    <link name="gripper_finger_left"/>
    <link name="gripper_finger_right"/>
  </group>

  <!-- ========================== -->
  <!--   END EFFECTOR TAG         -->
  <!-- ========================== -->
  <end_effector
      name="parallel_gripper"
      parent_link="wrist_3_link"
      group="gripper"/>

  <!-- ========================== -->
  <!--      OPTIONAL STATES       -->
  <!-- ========================== -->
  <group_state name="home" group="manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.57"/>
    <joint name="elbow_joint" value="1.57"/>
    <joint name="wrist_1_joint" value="-1.57"/>
    <joint name="wrist_2_joint" value="1.57"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <!-- ========================== -->
  <!--  ALLOWED COLLISIONS (BASIC)-->
  <!-- ========================== -->
  <disable_collisions link1="gripper_finger_left" link2="slider_rod_upper" reason="adjacent"/>
  <disable_collisions link1="gripper_finger_right" link2="slider_rod_upper" reason="adjacent"/>
  <disable_collisions link1="slider_rod_upper" link2="end_effector_main_frame" reason="adjacent"/>
  <disable_collisions link1="slider_rod_lower" link2="end_effector_main_frame" reason="adjacent"/>
  <disable_collisions link1="end_effector_mount_connector" link2="end_effector_main_frame" reason="adjacent"/>

</robot>

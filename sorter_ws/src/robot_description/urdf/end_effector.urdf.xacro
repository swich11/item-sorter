<?xml version="1.0"?>
<robot name="parallel_gripper_end_effector">
	<!--///////////////////////////////////////
		 _     ___ _   _ _  ______  
		| |   |_ _| \ | | |/ / ___| 
		| |    | ||  \| | ' /\___ \ 
		| |___ | || |\  | . \ ___) |
		|_____|___|_| \_|_|\_\____/ 

	/////////////////////////////////////// -->

	<!-- <link name="wrist_3_link"/> -->

	<!-- end effector mount connector housing (female) -->
	<link name="end_effector_mount_connector">
		<visual>
			<geometry>
				<mesh filename="package://robot_description/meshes/end_effector_mount_connector.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name='light_grey'>
				<color rgba="0.8 0.8 0.8 1"/>
			</material>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</visual>
		
		<collision>
			<geometry>
				<mesh filename="package://robot_description/meshes/end_effector_mount_connector.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</collision>

	</link>

	<!-- end effector mount insert (male) -->
	<link name="end_effector_main_frame">
		<visual>
			<geometry>
				<mesh filename="package://robot_description/meshes/end_effector_main_frame.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name='dark_grey'>
				<color rgba="0.25 0.25 0.3 1"/>
			</material>
		</visual>
			
		<collision>
			<geometry>
				<mesh filename="package://robot_description/meshes/end_effector_main_frame.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<!-- gripper fingers (left) -->
	<link name="gripper_finger_left">
		<visual>
			<geometry>
				<mesh filename="package://robot_description/meshes/gripper_finger_left.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name='dark_grey'/>
		</visual>

		<collision>
			<geometry>
				<mesh filename="package://robot_description/meshes/gripper_finger_left.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>	

	<!-- gripper fingers (right) -->
	<link name="gripper_finger_right">
		<visual>
			<geometry>
				<mesh filename="package://robot_description/meshes/gripper_finger_right.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name='dark_grey'/>
		</visual>

		<collision>
			<geometry>
				<mesh filename="package://robot_description/meshes/gripper_finger_right.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>	

	<!-- slider rod upper -->
	<link name="slider_rod_upper">
		<visual>
			<geometry>
				<mesh filename="package://robot_description/meshes/slider_rod.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name='dark_grey'/>
		</visual>	
	</link>	

	<!-- slider rod lower -->
	<link name="slider_rod_lower">
		<visual>
			<geometry>
				<mesh filename="package://robot_description/meshes/slider_rod.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name='dark_grey'/>
		</visual>	
	</link>	


	<!--///////////////////////////////////////
		 	 _  ___ ___ _   _ _____ ____  
			| |/ _ \_ _| \ | |_   _/ ___| 
		 _  | | | | | ||  \| | | | \___ \ 
		| |_| | |_| | || |\  | | |  ___) |
		 \___/ \___/___|_| \_| |_| |____/      

	/////////////////////////////////////// -->

	<!-- joint between wrist_link and end effector mount-->
	<!-- <joint name="end_effector_mount_connector_joint" type="fixed">
		<parent link="wrist_link"/>
		<child link="end_effector_mount_connector"/>
		<origin xyz="0 0 0" rpy="0 0 0"/>
	</joint> -->

	<!-- joint between main frame and end effector mount-->
	<joint name="end_effector_mount_connector_joint" type="fixed">
		<parent link="end_effector_mount_connector"/>
		<child link="end_effector_main_frame"/>
		<origin xyz="0 0.0525 -0.03" rpy="0 0 3.14"/>
	</joint>

	<!-- joint between main frame to slider 1-->
	<joint name="frame_slider_upper_joint" type="fixed">
		<parent link="end_effector_main_frame"/>
		<child link="slider_rod_upper"/>
		<origin xyz="0 0.036 0.0405" rpy="0 0 0"/>
	</joint>	

	<!-- joint between main frame to slider 2-->
	<joint name="frame_slider_lower_joint" type="fixed">
		<parent link="end_effector_main_frame"/>
		<child link="slider_rod_lower"/>
		<origin xyz="0 0.036 0.0105" rpy="0 0 0"/>
	</joint>

	<!-- joint between slider rod upper and left finger-->
	<joint name="left_finger_slide" type="fixed">
		<parent link="slider_rod_upper"/>
		<child link="gripper_finger_left"/>
		<origin xyz="0.029 -0.076 -0.040" rpy="0 0 0"/>
	</joint>

	<!-- joint between slider rod upper and left finger-->
	<joint name="right_finger_slide" type="fixed">
		<parent link="slider_rod_upper"/>
		<child link="gripper_finger_right"/>
		<origin xyz="-0.029 -0.076 -0.040" rpy="0 0 0"/>
	</joint>
</robot>
 